# Copier ce fichier en ".env" et l'adapter. Le fichier ".env" n'est JAMAIS versionné.

# --- Serveur central -----------------------------------------------------------------
# Base PostgreSQL du central (SQLite accepté uniquement pour les essais en local).
NKAP_CENTRAL_DATABASE_URL=postgresql+psycopg://nkap:CHANGER_MOI@localhost:5432/nkap_central
NKAP_CENTRAL_HOST=127.0.0.1
NKAP_CENTRAL_PORT=8800
# HTTPS (sinon placer le central derrière un proxy HTTPS comme Caddy ou nginx).
# NKAP_CENTRAL_SSL_CERTFILE=C:\nkap\certs\central.crt
# NKAP_CENTRAL_SSL_KEYFILE=C:\nkap\certs\central.key

# --- Nœud de site -------------------------------------------------------------------
# Base SQLite sur un disque LOCAL du nœud de site (jamais un lecteur réseau).
NKAP_SITE_DATABASE_URL=sqlite:///C:/Nkap/data/site.db
# Adresse du central ; vide = synchronisation désactivée.
NKAP_SITE_CENTRAL_URL=https://central.exemple.cm
# Jeton secret affiché UNE fois par « nkap-central register-site ».
NKAP_SITE_SYNC_TOKEN=nks_A_REMPLACER
NKAP_SITE_SYNC_INTERVAL_SECONDS=60
NKAP_SITE_SYNC_BATCH_SIZE=200
NKAP_SITE_CLOCK_DRIFT_TOLERANCE_MINUTES=10
# Rester sur 127.0.0.1 tant que l'authentification des utilisateurs (étape 2) n'existe pas.
NKAP_SITE_HOST=127.0.0.1
NKAP_SITE_PORT=8700
